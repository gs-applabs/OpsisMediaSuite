<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small Opsis plugin (contract 1.0.0.0) that shows the Opsis Media Suite (Electron) as a card and launches the installed app. Requires Opsis 2.6.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaSuite.OpsisPlugin</AssemblyName>
    <RootNamespace>MediaSuite.OpsisPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpsisNewsCrawler.Plugin.Abstractions">
      <HintPath>..\..\libs\OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
