{
  "name": "waveframe",
  "version": "2.4.2",
  "description": "Opsis Media Suite - audio enhancer, converter, video player and photo editor",
  "main": "main.js",
  "author": "gs-applabs",
  "homepage": "https://github.com/gs-applabs/OpsisMediaSuite",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:windows-desktop && electron-builder --win",
    "prebuild:windows-desktop": "node -e \"require('node:fs').rmSync('windows-desktop/out', { recursive: true, force: true })\"",
    "build:windows-desktop": "dotnet publish windows-desktop/Opsis.WindowsDesktop.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -p:DebugType=None -o windows-desktop/out",
    "smoke-test": "node smoke-test.js",
    "test": "node --test --test-concurrency=1 test/video.test.js test/video.real.test.js test/audiolib.test.js test/suite.test.js test/convert.test.js test/convert.real.test.js test/i18n.test.js test/security.test.js test/update-helper.test.js test/m3u.test.js test/photo.test.js test/videoplayer.test.js test/photosave.test.js test/flyout.test.js",
    "selftest": "node selftest.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "music-metadata": "^11.16.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "com.example.waveframe",
    "productName": "Opsis Media Suite",
    "copyright": "Copyright (c) 2026 gs-applabs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "atomic-write.js",
      "local-path.js",
      "ipc-trust.js",
      "renderer-protocol.js",
      "audio-tags.js",
      "preload.js",
      "flyout-main.js",
      "flyout-preload.js",
      "windows-desktop.js",
      "splash-preload.js",
      "suite.js",
      "suite-main.js",
      "conv-engine.js",
      "conv-main.js",
      "conv-video.js",
      "ffmpeg-path.js",
      "media-main.js",
      "photo-metadata.js",
      "media-types.js",
      "suite-apps.json",
      "icon.ico",
      "renderer/**/*",
      "decode-text.js",
      "m3u.js"
    ],
    "extraResources": [
      {
        "from": "windows-desktop/out",
        "to": "windows-desktop"
      }
    ],
    "asarUnpack": [
      "node_modules/music-metadata/**/*",
      "node_modules/@borewit/**/*",
      "node_modules/@tokenizer/**/*",
      "node_modules/content-type/**/*",
      "node_modules/debug/**/*",
      "node_modules/file-type/**/*",
      "node_modules/media-typer/**/*",
      "node_modules/strtok3/**/*",
      "node_modules/token-types/**/*",
      "node_modules/uint8array-extras/**/*",
      "node_modules/win-guid/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MP3 Audio File"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "WAV Audio File"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio File"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "OGG Vorbis Audio File"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "AAC Audio File"
      },
      {
        "ext": "opus",
        "name": "Opus Audio",
        "description": "Opus Audio File"
      },
      {
        "ext": "wma",
        "name": "WMA Audio",
        "description": "WMA Audio File"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico",
      "artifactName": "OpsisMediaSuite-${version}.${ext}"
    }
  }
}
